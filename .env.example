# Copy to .env.local and fill in. Never commit real values.
# Variables without the NEXT_PUBLIC_ prefix are server-only.

# --- News provider (server-only) ---
# Free key from https://gnews.io/  — development/testing plan.
GNEWS_API_KEY=

# --- Database (optional) ---
# Leave all three blank to use the built-in local JSON store at .data/articles.json.
# Set all three to use Supabase Postgres instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion endpoint (server-only) ---
# Any long random string. Required by POST /api/internal/collect-news.
CRON_SECRET=

# --- Optional AI enrichment (server-only) ---
AI_ENRICHMENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_ENRICHMENTS_PER_RUN=25

# --- Optional tuning ---
# Articles requested from the provider per category, per run (GNews max is 100).
COLLECT_ARTICLES_PER_CATEGORY=10
# Only accept articles published within this many hours of the run.
COLLECT_MAX_AGE_HOURS=72
